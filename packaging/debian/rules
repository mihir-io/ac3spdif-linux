#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_APP=ON -DBUILD_TESTS=ON

override_dh_auto_test:
	dh_auto_test
	desktop-file-validate data/org.ac3spdif.App.desktop
	appstreamcli validate --no-net data/org.ac3spdif.App.metainfo.xml
